module std::result;

import std::option;

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

// Variant constructor hooks (M1-3): bypass the P3 free-function variant-
// construction limitation (type args resolve to Any). Prefer Result::Ok / Err
// syntax where it typechecks; use these in construction-heavy generic fns.
@builtin("result_ok")
fn result_ok<T, E>(value: T) -> Result<T, E> effect Pure;

@builtin("result_err")
fn result_err<T, E>(error: E) -> Result<T, E> effect Pure;

// Inherent methods preserve successful values or propagate errors.
impl<T, E> Result<T, E> {
    pub fn is_ok(self) -> Bool effect Pure decreases 0 {
        return match self { Ok(_) => true, Err(_) => false };
    }

    pub fn is_err(self) -> Bool effect Pure decreases 0 {
        return match self { Ok(_) => false, Err(_) => true };
    }

    pub fn map<U>(self, f: Fn(T) -> U) -> Result<U, E> effect Pure decreases 0 {
        return match self {
            Ok(value) => Result::Ok(f(value)),
            Err(error) => Result::Err(error)
        };
    }

    pub fn map_err<F>(self, f: Fn(E) -> F) -> Result<T, F> effect Pure decreases 0 {
        return match self {
            Ok(value) => Result::Ok(value),
            Err(error) => Result::Err(f(error))
        };
    }

    pub fn and_then<U>(self, f: Fn(T) -> Result<U, E>) -> Result<U, E> effect Pure decreases 0 {
        return match self { Ok(value) => f(value), Err(error) => Result::Err(error) };
    }

    pub fn or_else<F>(self, alt: Fn(E) -> Result<T, F>) -> Result<T, F> effect Pure decreases 0 {
        return match self { Ok(value) => Result::Ok(value), Err(error) => alt(error) };
    }

    pub fn unwrap_or(self, default: T) -> T effect Pure decreases 0 {
        return match self { Ok(value) => value, Err(_) => default };
    }

    pub fn unwrap_or_else(self, default: Fn(E) -> T) -> T effect Pure decreases 0 {
        return match self { Ok(value) => value, Err(error) => default(error) };
    }

    pub fn ok(self) -> option::Option<T> effect Pure decreases 0 {
        return match self {
            Ok(value) => option::Option::Some(value),
            Err(_) => option::Option::None
        };
    }

    pub fn err(self) -> option::Option<E> effect Pure decreases 0 {
        return match self {
            Ok(_) => option::Option::None,
            Err(error) => option::Option::Some(error)
        };
    }

}

// Convert an Option, constructing an error only for None.
pub fn from_option<T, E>(opt: option::Option<T>, mk_err: Fn() -> E)
    -> Result<T, E> effect Pure decreases 0
{
    return match opt {
        option::Option::Some(value) => Result::Ok(value),
        option::Option::None => Result::Err(mk_err()),
    };
}

/// Functional composition equivalent to Result::and_then.
pub fn flat_map<T, U, E>(self: Result<T, E>, f: Fn(T) -> Result<U, E>) -> Result<U, E> effect Pure decreases 0 {
    return self.and_then<U>(f);
}

/// flatten (M1-3): collapse Result<Result<T, E>, E> -> Result<T, E>. Uses
/// and_then(identity) because P3 cannot directly construct a generic enum
/// variant inside a free-function body (the type args resolve to Any); passing
/// the inner Result through unchanged avoids that construction.
pub fn flatten<T, E>(self: Result<Result<T, E>, E>) -> Result<T, E> effect Pure decreases 0 {
    return self.and_then<T>(\inner: Result<T, E> -> inner);
}

/// transpose (M1-3): Result<Option<T>, E> -> Option<Result<T, E>>. Uses the
/// result_ok / result_err / option_some constructor hooks because P3 cannot
/// construct generic variants via syntax inside a free-function body.
pub fn transpose<T, E>(self: Result<option::Option<T>, E>) -> option::Option<Result<T, E>> effect Pure decreases 0 {
    return match self {
        Ok(opt) => match opt {
            option::Option::Some(v) => option::option_some<Result<T, E>>(result_ok<T, E>(v)),
            option::Option::None => option::Option::None
        },
        Err(e) => option::option_some<Result<T, E>>(result_err<T, E>(e))
    };
}
