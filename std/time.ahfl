module std::time;

// Canonical host capability for reading the wall clock (RFC 0022 / RFC 0023).
// Nondeterminism is owned by the host and reified as a named capability so its
// result flows through the InvocationId / memo path and durable replay is sound.
pub capability Clock() -> Timestamp {
    effect: read;
    receipt: none;
    retry: safe;
}

// Deterministic time builtins (pure) — unchanged.
@builtin("time_epoch")
fn time_epoch() -> Timestamp effect Pure;

@builtin("time_add")
fn time_add(t: Timestamp, delta: Duration) -> Timestamp effect Pure;

@builtin("time_sub")
fn time_sub(t: Timestamp, delta: Duration) -> Timestamp effect Pure;

@builtin("time_duration_between")
fn time_duration_between(start: Timestamp, end: Timestamp) -> Duration effect Pure;

// ===========================================================================
// P3 inherent impl on primitive Timestamp / Duration types.
// ===========================================================================

impl Timestamp {
    pub fn add(self, delta: Duration) -> Timestamp effect Pure decreases 0 {
        return time_add(self, delta);
    }

    pub fn sub(self, delta: Duration) -> Timestamp effect Pure decreases 0 {
        return time_sub(self, delta);
    }

    pub fn duration_until(self, other: Timestamp) -> Duration effect Pure decreases 0 {
        return time_duration_between(self, other);
    }
}

impl Duration {}

// ===========================================================================
// Module-level surface.
// ===========================================================================

// Reads the wall clock via the Clock host capability (RFC 0023: the effect row
// names the capability, so the result is memoizable for durable replay).
pub fn now() -> Timestamp effect Clock {
    return Clock();
}

pub fn epoch() -> Timestamp effect Pure decreases 0 {
    return time_epoch();
}

pub fn add(self: Timestamp, delta: Duration) -> Timestamp effect Pure decreases 0 {
    return self.add(delta);
}

pub fn sub(self: Timestamp, delta: Duration) -> Timestamp effect Pure decreases 0 {
    return self.sub(delta);
}

pub fn duration_between(start: Timestamp, end: Timestamp) -> Duration effect Pure decreases 0 {
    return time_duration_between(start, end);
}
