module std::option;

pub enum Option<T> {
    Some(T),
    None,
}

// Variant constructor hook (M1-3): bypass the P3 free-function variant-
// construction limitation. Prefer Option::Some syntax where it typechecks.
@builtin("option_some")
fn option_some<T>(value: T) -> Option<T> effect Pure;

// ---------------------------------------------------------------------------
// Inherent impl (P3, RFC §2). Canonical surface: opt.map(f), opt.is_some().
// ---------------------------------------------------------------------------
impl<T> Option<T> {
    pub fn is_some(self) -> Bool effect Pure decreases 0 {
        return self != Option::None;
    }

    pub fn is_none(self) -> Bool effect Pure decreases 0 {
        return self == Option::None;
    }

    pub fn map<U>(self, f: Fn(T) -> U) -> Option<U> effect Pure decreases 0 {
        return match self { Some(value) => Option::Some(f(value)), None => Option::None };
    }

    pub fn and_then<U>(self, f: Fn(T) -> Option<U>) -> Option<U> effect Pure decreases 0 {
        return match self { Some(value) => f(value), None => Option::None };
    }

    pub fn or_else(self, alt: Fn() -> Option<T>) -> Option<T> effect Pure decreases 0 {
        return match self { Some(value) => Option::Some(value), None => alt() };
    }

    pub fn filter(self, p: Fn(T) -> Bool) -> Option<T> effect Pure decreases 0 {
        return match self {
            Some(value) => option_filter_value<T>(value, p),
            None => Option::None
        };
    }

    pub fn unwrap_or(self, default: T) -> T effect Pure decreases 0 {
        return match self { Some(value) => value, None => default };
    }

    pub fn unwrap_or_else(self, default: Fn() -> T) -> T effect Pure decreases 0 {
        return match self { Some(value) => value, None => default() };
    }

    pub fn get_or_insert(self, value: T) -> T effect Pure decreases 0 {
        return self.unwrap_or(value);
    }

    // xor: Some exactly when one operand contains a value.
    pub fn xor(self, other: Option<T>) -> Option<T> effect Pure decreases 0 {
        return match self {
            Some(va) => match other {
                Some(_) => Option::None,
                None => Option::Some(va)
            },
            None => other
        };
    }
}

// ---------------------------------------------------------------------------
// Internal helper (referenced by filter). Keep `option_` prefix so the bare
// identifier `filter_value` is never ambiguous with Set/Map helpers.
// ---------------------------------------------------------------------------
fn option_filter_value<T>(value: T, p: Fn(T) -> Bool) -> Option<T> effect Pure decreases 0 {
    if p(value) {
        return Option::Some(value);
    }
    return Option::None;
}

// UFCS surface for xor (M1-2, new API): allows option::xor<T>(a, b) as well as
// a.xor(b). This is the functional composition entry point.
pub fn xor<T>(self: Option<T>, other: Option<T>) -> Option<T> effect Pure decreases 0 {
    return self.xor(other);
}

// Functional composition equivalent to Option::and_then.
pub fn flat_map<T, U>(self: Option<T>, f: Fn(T) -> Option<U>) -> Option<U> effect Pure decreases 0 {
    return self.and_then<U>(f);
}

pub fn filter_value<T>(value: T, p: Fn(T) -> Bool) -> Option<T> effect Pure decreases 0 {
    return option_filter_value<T>(value, p);
}

// Constructor helpers (RFC §2 common surface). `some` / `none` are the
// functional-style entry points re-exported by prelude §9.1.1 via sugar.
// They desugar from `some(value)` / `none` list-literal form during P5
// sugar lowering, but the standalone functions are also exposed so users
// can pass them as `Fn` values to higher-order combinators.

pub fn some<T>(value: T) -> Option<T> effect Pure decreases 0 {
    return Option::Some(value);
}

pub fn option_none<T>() -> Option<T> effect Pure decreases 0 {
    // NOTE: bare `none` is a reserved word in AHFL P3 grammar (matches the
    // constructor in the Option enum); we export the function under the
    // prefixed name `option_none` and rely on prelude §9.1.1 sugar to
    // translate the literal `none` to Option::None.
    return Option::None;
}
