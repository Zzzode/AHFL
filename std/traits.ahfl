module std::traits;

import std::cmp;
import std::collections;
import std::option;

// ===========================================================================
// JsonValue ADT — declared FIRST because P3 trait signatures do not support
// forward references to same-module types. The fully-blown JsonValue with
// predicates/accessors/parse/emit lives in std/json.ahfl; here we only
// declare the data shape that FromJson/ToJson and container variant payloads
// reference. If std/json.ahfl re-declares the same enum, the AHFL resolver
// will treat it as a redefinition — P6a standardizes on std/json.ahfl owning
// the definition and this file importing it.
//
// Variant payloads use J-prefixed names (not Bool/Int/String) to avoid
// shadowing built-in primitive type names in the enum variant namespace.
//
// Local type aliases follow immediately. P3 enum-variant payloads do NOT
// resolve module-qualified names like `collections::List<...>`, so we alias
// them to unqualified names before the enum.
// ===========================================================================

pub type List<T> = collections::List<T>;
pub type Map<K, V> = collections::Map<K, V>;
pub type Option<T> = option::Option<T>;

// NOTE: JsonValue enum shape MUST match the canonical definition in
// std/json.ahfl exactly (variant names + payload types). The resolver treats
// duplicate nominal enum declarations with identical shapes as a single
// unified symbol. P6a delegates the full set of helpers (predicates,
// accessors, parse, emit) to std/json.ahfl; traits.ahfl only owns the
// variant names used by FromJson / ToJson trait dispatch. Recursive payloads
// (JList → List<JsonValue>, JEntries → Map<String, JsonValue>) are supported
// via the resolver's recursive-ADT two-pass extension.
pub enum JsonValue {
    JNull,
    JBool(Bool),
    JInt(Int),
    JFloat(Float),
    JText(String),
    JList(List<JsonValue>),
    JEntries(Map<String, JsonValue>),
}

// ===========================================================================
// 11 core traits — API §6 interface-freeze.
//
// AHFL's P3 trait grammar supports:
//   `trait Name { fn method(self: ReceiverType, ...) -> ReturnType effect ... ; }`
//   `trait Child: Parent { ... }` for trait inheritance (e.g. Ord: Eq).
//
// Since P3c (2026-08-22) the `Self` contextual keyword is resolved inside
// trait method signatures as the implicit front-most receiver type parameter
// (TypeVarT index 0 in TraitTypeInfo::self_augmented_type_param_names), and
// trait-level type parameters (`trait Iterable<T>`) resolve to TypeVarT
// index 1..N. The traits below are therefore polymorphic over Self (the
// implementing type) and, for the container-element traits, over T (the
// element type):
//
//   Eq/Ord/Hash/Display/Debug/ToJson: `self: Self`, returns `Self`/`Bool`/...
//   FromStr/FromJson:                no self param, `-> Option<Self>`
//   Iterable<T>/Foldable<T>/Functor<T>: `self: Self`, T for element types
//
// `impl Trait for Type` blocks match these signatures by substitution: the
// impl's target type replaces Self and the impl's trait type arguments
// replace the trait-level T (signatures_match, typecheck.cpp). Concrete
// placeholder receiver types (the pre-P3c skeleton) are gone — they made
// generic impls like `impl<T> Eq for Option<T>` fail with
// TRAIT_METHOD_SIGNATURE_MISMATCH.
//
// Known limitation: container-wrapped Self (`self: Option<Self>`) is not
// matched by the synthetic-candidate dispatch path; none of the 11 traits
// use that shape.
// ===========================================================================

// ---- §6.1 Eq / Ord / Hash -------------------------------------------------

pub trait Eq {
    fn eq(self: Self, other: Self) -> Bool effect Pure;
    fn ne(self: Self, other: Self) -> Bool effect Pure;
}

// Ord inherits Eq; relational helpers + min/max/clamp are defaults delegated
// to `compare` via the module-level wrappers at the bottom of this file.
pub trait Ord: Eq {
    fn compare(self: Self, other: Self) -> cmp::Ordering effect Pure;
    fn lt(self: Self, other: Self) -> Bool effect Pure;
    fn le(self: Self, other: Self) -> Bool effect Pure;
    fn gt(self: Self, other: Self) -> Bool effect Pure;
    fn ge(self: Self, other: Self) -> Bool effect Pure;
    fn max(self: Self, other: Self) -> Self effect Pure;
    fn min(self: Self, other: Self) -> Self effect Pure;
    fn clamp(self: Self, lo: Self, hi: Self) -> Self effect Pure;
}

pub trait Hash {
    fn hash(self: Self) -> Int effect Pure;
}

// ---- §6.2 Iterable / Foldable / Functor -----------------------------------
//
// T is the container's element type, supplied by each impl's trait type
// argument (e.g. `impl<T> Iterable<T> for List<T>`).

pub trait Iterable<T> {
    fn iter_next(self: Self) -> Option<T> effect Pure;
    fn iter_head(self: Self) -> Option<T> effect Pure;
    fn iter_tail(self: Self) -> Self effect Pure;
}

pub trait Foldable<T> {
    fn length(self: Self) -> Int effect Pure;
    fn fold(self: Self, init: T, f: Fn(T, T) -> T) -> T effect Pure;
    fn for_each(self: Self, f: Fn(T) -> Unit) -> Unit effect Pure;
    fn to_list(self: Self) -> Self effect Pure;
}

pub trait Functor<T> {
    fn map(self: Self, f: Fn(T) -> T) -> Self effect Pure;
}

// ---- §6.3 Display / Debug / FromStr / FromJson / ToJson ------------------

pub trait Display {
    fn fmt(self: Self) -> String effect Pure;
}

pub trait Debug {
    fn debug(self: Self) -> String effect Pure;
}

pub trait FromStr {
    fn from_str(s: String) -> Option<Self> effect Pure;
}

pub trait FromJson {
    // `value` is declared opaque here; the real JsonValue ADT is declared at
    // the top of this file (same module) and resolved during the same
    // type-check pass.
    fn from_json(value: JsonValue) -> Option<Self> effect Pure;
}

pub trait ToJson {
    // Return type is JsonValue (opaque forward, defined above in this module).
    fn to_json(self: Self) -> JsonValue effect Pure;
}

// ===========================================================================
// Phase A default-body wrappers.
//
// Concrete impls that only want to write the *required* method (e.g. `eq`
// for Eq, `compare` for Ord) can forward the remaining methods to these
// helpers. Usage:
//
//     impl Eq for MyType {
//         fn eq(self: Self, other: Self) -> Bool effect Pure decreases 0 {
//             /* user-provided */
//         }
//         fn ne(self: Self, other: Self) -> Bool effect Pure decreases 0 {
//             return eq_default_ne_impl<MyType>(self, other, \a b -> a.eq(b));
//         }
//     }
//
// PHASE B (P6a): inline these bodies as trait-level default method bodies
// once the grammar + resolver support them.
// ===========================================================================

fn eq_default_ne_impl<T>(self: T, other: T, eq_of: Fn(T, T) -> Bool)
    -> Bool effect Pure decreases 0
{
    return not eq_of(self, other);
}

fn ord_default_lt_impl<T>(self: T, other: T, cmp_of: Fn(T, T) -> cmp::Ordering)
    -> Bool effect Pure decreases 0
{
    return cmp_of(self, other) == cmp::Ordering::Less;
}

fn ord_default_le_impl<T>(self: T, other: T, cmp_of: Fn(T, T) -> cmp::Ordering)
    -> Bool effect Pure decreases 0
{
    let c: cmp::Ordering = cmp_of(self, other);
    return (c == cmp::Ordering::Less) or (c == cmp::Ordering::Equal);
}

fn ord_default_gt_impl<T>(self: T, other: T, cmp_of: Fn(T, T) -> cmp::Ordering)
    -> Bool effect Pure decreases 0
{
    return cmp_of(self, other) == cmp::Ordering::Greater;
}

fn ord_default_ge_impl<T>(self: T, other: T, cmp_of: Fn(T, T) -> cmp::Ordering)
    -> Bool effect Pure decreases 0
{
    let c: cmp::Ordering = cmp_of(self, other);
    return (c == cmp::Ordering::Greater) or (c == cmp::Ordering::Equal);
}

fn ord_default_max_impl<T>(self: T, other: T, gt_of: Fn(T, T) -> Bool)
    -> T effect Pure decreases 0
{
    if gt_of(self, other) {
        return self;
    }
    return other;
}

fn ord_default_min_impl<T>(self: T, other: T, lt_of: Fn(T, T) -> Bool)
    -> T effect Pure decreases 0
{
    if lt_of(self, other) {
        return self;
    }
    return other;
}

fn ord_default_clamp_impl<T>(
    self: T,
    lo: T,
    hi: T,
    lt_of: Fn(T, T) -> Bool,
    gt_of: Fn(T, T) -> Bool
) -> T effect Pure decreases 0 {
    if lt_of(self, lo) {
        return lo;
    }
    if gt_of(self, hi) {
        return hi;
    }
    return self;
}

// NOTE: JsonValue is now declared at the TOP of this file (immediately after
// imports) so FromJson/ToJson trait signatures in the middle of the file can
// resolve it. The full ADT + APIs live in std/json.ahfl and take over the
// ownership of this type in P6a.
