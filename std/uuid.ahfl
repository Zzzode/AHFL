module std::uuid;

import std::option;

// Canonical host capability for minting a fresh v4 UUID (RFC 0022 / RFC 0023).
// Entropy is owned by the host and reified as a named capability so its result
// flows through the InvocationId / memo path and durable replay is sound.
pub capability UuidV4() -> UUID {
    effect: read;
    receipt: none;
    retry: safe;
}

// Deterministic uuid builtins (pure) — unchanged.
@builtin("uuid_parse")
fn uuid_parse(s: String) -> option::Option<UUID> effect Pure;

@builtin("uuid_to_string")
fn uuid_to_string(u: UUID) -> String effect Pure;

// ===========================================================================
// P3 inherent impl on the UUID primitive type.
// ===========================================================================

impl UUID {
    pub fn to_string(self) -> String effect Pure decreases 0 {
        return uuid_to_string(self);
    }
}

// Module-level surface.
// Mints a fresh v4 UUID via the UuidV4 host capability (RFC 0023: the effect row
// names the capability, so the result is memoizable for durable replay).
pub fn new_v4() -> UUID effect UuidV4 {
    return UuidV4();
}

pub fn parse(s: String) -> option::Option<UUID> effect Pure decreases 0 {
    return uuid_parse(s);
}

pub fn to_string(self: UUID) -> String effect Pure decreases 0 {
    return self.to_string();
}
