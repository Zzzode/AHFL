// X-macro node list for ahfl::ir::MatchPatternNode (RFC 0027 P6/P7/P8,
// KR6.13-F): the SINGLE source of truth for the AHFL-IR match-pattern node set.
//
// This file intentionally has NO include guard. It is a text fragment that is
// re-included once per consumer; every consumer must first define the
// HANDLE_PATTERN_NODE(Name, Wire) macro. The expansion is one HANDLE_PATTERN_NODE
// invocation per node, IN DECLARATION ORDER. That order is simultaneously:
//   * the MatchPatternNode std::variant alternative order (generated in
//     expr.hpp through node_detail::node_tag),
//   * the match_pattern_node_detail::MatchPatternNodeIndex enumerator order, and
//   * the match_pattern_node_detail::kMatchPatternWireNames table order.
//   * every per-node handler table / macro-expansion order at the consumer
//     sites (verify / json / typecheck).
// Reordering an entry changes std::variant::index() values and is therefore a
// breaking change; append new nodes at the END.
//
// The second macro argument is the JSON wire spelling the `ir_json.cpp` writer
// emits in the `"kind"` field and the reader accepts; that mapping is resolved
// from THIS table on both sides, so a wire-name typo is a single edit that both
// sides observe (a reader that sees an unknown spelling fails closed instead of
// silently demoting the node).
//
// Every exhaustive consumer routes through one explicit per-node handler macro
// (`<prefix>_##Name`), so adding a node here WITHOUT adding every per-node
// handler is a COMPILE ERROR naming the missing type rather than a silently
// skipped node (CLAUDE.md Principle 5). The property is pinned by the negative
// compile-test tests/fixtures/ir/ssot/pattern_nodes_negative.cpp
// (syntax-compiled by tests/scripts/ir_ssot_compile_fail.py) and independently
// by tests/unit/compiler/ir/node_variant_coverage.cpp.
//
// Usage:
//   #define HANDLE_PATTERN_NODE(Name, Wire) /* ... Name ... */
//   #include "ahfl/compiler/ir/pattern_nodes.def"
//
// The file #undefs HANDLE_PATTERN_NODE at the end so the driver macro never
// leaks past a consumer; consumer-specific per-node helper macros are the
// consumer's own responsibility to #undef.

#ifndef HANDLE_PATTERN_NODE
#error "pattern_nodes.def: #define HANDLE_PATTERN_NODE(Name, Wire) before #include-ing this node list"
#endif

HANDLE_PATTERN_NODE(LiteralPattern, "literal")
HANDLE_PATTERN_NODE(IntRangePattern, "int_range")
HANDLE_PATTERN_NODE(VariantPattern, "variant")
HANDLE_PATTERN_NODE(WildcardPattern, "wildcard")
HANDLE_PATTERN_NODE(BindingPattern, "binding")
HANDLE_PATTERN_NODE(TuplePattern, "tuple")
HANDLE_PATTERN_NODE(OrPattern, "or")

#undef HANDLE_PATTERN_NODE
