// X-macro node list for ahfl::ir::Decl (RFC 0027 P6/P7/P8, KR6.13-F): the
// SINGLE source of truth for the AHFL-IR top-level declaration set.
//
// This file intentionally has NO include guard. It is a text fragment that is
// re-included once per consumer; every consumer must first define the
// HANDLE_DECL_NODE(Name, Wire) macro. The expansion is one HANDLE_DECL_NODE
// invocation per node, IN DECLARATION ORDER. That order is simultaneously:
//   * the Decl std::variant alternative order (generated in program.hpp
//     through node_detail::node_tag), and
//   * every per-node handler table / macro-expansion order at the consumer
//     sites (verify / json / visitor / smv / ir_lower / program_view).
// Reordering an entry changes std::variant::index() values and is therefore a
// breaking change; append new nodes at the END.
//
// Every exhaustive consumer routes through one explicit per-node handler macro
// (`<prefix>_##Name`), so adding a node here WITHOUT adding every per-node
// handler is a COMPILE ERROR naming the missing type rather than a silently
// skipped node (CLAUDE.md Principle 5). The property is pinned by the negative
// compile-test tests/fixtures/ir/ssot/decl_nodes_negative.cpp (syntax-compiled
// by tests/scripts/ir_ssot_compile_fail.py under ctest ahfl.ir.ssot_compile_fail)
// and independently by tests/unit/compiler/ir/node_variant_coverage.cpp.
//
// Usage:
//   #define HANDLE_DECL_NODE(Name, Wire) /* ... Name ... */
//   #include "ahfl/compiler/ir/decl_nodes.def"
//
// The file #undefs HANDLE_DECL_NODE at the end so the driver macro never leaks
// past a consumer; consumer-specific per-node helper macros are the consumer's
// own responsibility to #undef.

#ifndef HANDLE_DECL_NODE
#error "decl_nodes.def: #define HANDLE_DECL_NODE(Name, Wire) before #include-ing this node list"
#endif

HANDLE_DECL_NODE(ModuleDecl, "module")
HANDLE_DECL_NODE(ImportDecl, "import")
HANDLE_DECL_NODE(ConstDecl, "const")
HANDLE_DECL_NODE(TypeAliasDecl, "type_alias")
HANDLE_DECL_NODE(StructDecl, "struct")
HANDLE_DECL_NODE(EnumDecl, "enum")
HANDLE_DECL_NODE(CapabilityDecl, "capability")
HANDLE_DECL_NODE(PredicateDecl, "predicate")
HANDLE_DECL_NODE(AgentDecl, "agent")
HANDLE_DECL_NODE(ContractDecl, "contract")
HANDLE_DECL_NODE(FlowDecl, "flow")
HANDLE_DECL_NODE(WorkflowDecl, "workflow")
HANDLE_DECL_NODE(FnDecl, "fn")
HANDLE_DECL_NODE(TraitDecl, "trait")
HANDLE_DECL_NODE(ImplDecl, "impl")
HANDLE_DECL_NODE(InstanceDecl, "instance")

#undef HANDLE_DECL_NODE
