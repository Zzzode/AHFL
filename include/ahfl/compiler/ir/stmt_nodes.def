// X-macro node list for ahfl::ir::StatementNode (RFC 0027 P6/P7/P8, KR6.13-F):
// the SINGLE source of truth for the AHFL-IR statement node set.
//
// This file intentionally has NO include guard. It is a text fragment that is
// re-included once per consumer; every consumer must first define the
// HANDLE_STMT_NODE(Name, Wire) macro. The expansion is one HANDLE_STMT_NODE
// invocation per node, IN DECLARATION ORDER. That order is simultaneously:
//   * the StatementNode std::variant alternative order (generated in expr.hpp
//     through node_detail::node_tag), and
//   * every per-node handler table / macro-expansion order at the consumer
//     sites (verify / json / executor / print).
// Reordering an entry changes std::variant::index() values and is therefore a
// breaking change; append new nodes at the END.
//
// Every exhaustive consumer routes through one explicit per-node handler macro
// (`<prefix>_##Name`), so adding a node here WITHOUT adding every per-node
// handler is a COMPILE ERROR naming the missing type rather than a silently
// skipped node (CLAUDE.md Principle 5). The property is pinned by the negative
// compile-test tests/fixtures/ir/ssot/stmt_nodes_negative.cpp (syntax-compiled
// by tests/scripts/ir_ssot_compile_fail.py under ctest ahfl.ir.ssot_compile_fail)
// and independently by tests/unit/compiler/ir/node_variant_coverage.cpp.
//
// Usage:
//   #define HANDLE_STMT_NODE(Name, Wire) /* ... Name ... */
//   #include "ahfl/compiler/ir/stmt_nodes.def"
//
// The file #undefs HANDLE_STMT_NODE at the end so the driver macro never leaks
// past a consumer; consumer-specific per-node helper macros are the consumer's
// own responsibility to #undef.

#ifndef HANDLE_STMT_NODE
#error "stmt_nodes.def: #define HANDLE_STMT_NODE(Name, Wire) before #include-ing this node list"
#endif

HANDLE_STMT_NODE(LetStatement, "let")
HANDLE_STMT_NODE(AssignStatement, "assign")
HANDLE_STMT_NODE(IfStatement, "if")
HANDLE_STMT_NODE(IfLetStatement, "if_let")
HANDLE_STMT_NODE(GotoStatement, "goto")
HANDLE_STMT_NODE(ReturnStatement, "return")
HANDLE_STMT_NODE(AssertStatement, "assert")
HANDLE_STMT_NODE(UnwrapStatement, "unwrap")
HANDLE_STMT_NODE(RequiresStatement, "requires")
HANDLE_STMT_NODE(UnreachableStatement, "unreachable")
HANDLE_STMT_NODE(ExprStatement, "expr")

#undef HANDLE_STMT_NODE
