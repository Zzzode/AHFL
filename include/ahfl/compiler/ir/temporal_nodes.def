// X-macro node list for ahfl::ir::TemporalExprNode (RFC 0027 P6/P7/P8,
// KR6.13-F): the SINGLE source of truth for the AHFL-IR temporal-expression
// node set.
//
// This file intentionally has NO include guard. It is a text fragment that is
// re-included once per consumer; every consumer must first define the
// HANDLE_TEMPORAL_NODE(Name) macro. The expansion is one HANDLE_TEMPORAL_NODE
// invocation per node, IN DECLARATION ORDER. That order is simultaneously:
//   * the TemporalExprNode std::variant alternative order (generated in
//     expr.hpp through node_detail::node_tag), and
//   * every per-node handler table / macro-expansion order at the consumer
//     sites (verify / smv / ir_lower / json).
// Reordering an entry changes std::variant::index() values and is therefore a
// breaking change; append new nodes at the END.
//
// Every exhaustive consumer routes through one explicit per-node handler macro
// (`<prefix>_##Name`), so adding a node here WITHOUT adding every per-node
// handler is a COMPILE ERROR naming the missing type rather than a silently
// skipped node (CLAUDE.md Principle 5). The property is pinned by the negative
// compile-test tests/fixtures/ir/ssot/temporal_nodes_negative.cpp
// (syntax-compiled by tests/scripts/ir_ssot_compile_fail.py) and independently
// by tests/unit/compiler/ir/node_variant_coverage.cpp.
//
// Usage:
//   #define HANDLE_TEMPORAL_NODE(Name) /* ... Name ... */
//   #include "ahfl/compiler/ir/temporal_nodes.def"
//
// The file #undefs HANDLE_TEMPORAL_NODE at the end so the driver macro never
// leaks past a consumer; consumer-specific per-node helper macros are the
// consumer's own responsibility to #undef.

#ifndef HANDLE_TEMPORAL_NODE
#error "temporal_nodes.def: #define HANDLE_TEMPORAL_NODE(Name) before #include-ing this node list"
#endif

HANDLE_TEMPORAL_NODE(EmbeddedTemporalExpr)
HANDLE_TEMPORAL_NODE(CalledTemporalExpr)
HANDLE_TEMPORAL_NODE(InStateTemporalExpr)
HANDLE_TEMPORAL_NODE(RunningTemporalExpr)
HANDLE_TEMPORAL_NODE(CompletedTemporalExpr)
HANDLE_TEMPORAL_NODE(TemporalUnaryExpr)
HANDLE_TEMPORAL_NODE(TemporalBinaryExpr)

#undef HANDLE_TEMPORAL_NODE
