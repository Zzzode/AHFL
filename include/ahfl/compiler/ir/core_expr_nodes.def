// X-macro node list for ahfl::ir::core::CoreExprNode (RFC 0027 P6/P7/P8,
// KR6.13-P7): the SINGLE source of truth for the Core-IR pure-expression node
// set — the Core counterpart of expr_nodes.def / stmt_nodes.def and a sibling
// of core_value_types.def.
//
// This file intentionally has NO include guard. It is a text fragment that is
// re-included once per consumer; every consumer must first define the
// HANDLE_CORE_EXPR_NODE(Name, Wire) macro. The expansion is one
// HANDLE_CORE_EXPR_NODE invocation per node, IN DECLARATION ORDER. That order
// is simultaneously:
//   * the CoreExprNode std::variant alternative order (generated in
//     core_ir.hpp through node_detail::node_tag), and
//   * every per-node handler table / macro-expansion order at the consumer
//     sites (core_verify / core_lower / ir_json).
// Reordering an entry changes std::variant::index() values and is therefore a
// breaking change; append new nodes at the END.
//
// The second macro argument is the JSON wire spelling the Core-IR JSON printer
// emits in the `"kind"` field and the reader accepts (RFC 0026 P9 §3): both
// sides resolve the mapping from THIS one table, so a wire-name typo is a single
// edit both sides observe. A consumer that does not want the column (the
// variant / name table / visitors) simply ignores the second parameter.
//
// Every exhaustive consumer routes through one explicit per-node handler macro
// (`<prefix>_##Name`), so adding a node here WITHOUT adding every per-node
// handler is a COMPILE ERROR naming the missing type rather than a silently
// skipped node (CLAUDE.md Principle 5). The property is pinned by the negative
// compile-test tests/fixtures/ir/ssot/core_expr_nodes_negative.cpp
// (syntax-compiled by tests/scripts/ir_ssot_compile_fail.py under ctest
// ahfl.ir.ssot_compile_fail) and independently by
// tests/unit/compiler/ir/node_variant_coverage.cpp.
//
// Note: CoreExprNode is the LOWERED execution-layer node set. Its members are
// deliberately a subset of the AhflIr ExprNode set (verification / temporal /
// contract constructs are erased at this layer), which is why it is a distinct
// X-list and NOT a re-expansion of expr_nodes.def.
//
// Usage:
//   #define HANDLE_CORE_EXPR_NODE(Name, Wire) /* ... Name ... Wire ... */
//   #include "ahfl/compiler/ir/core_expr_nodes.def"
//
// The file #undefs HANDLE_CORE_EXPR_NODE at the end so the driver macro never
// leaks past a consumer; consumer-specific per-node helper macros are the
// consumer's own responsibility to #undef.

#ifndef HANDLE_CORE_EXPR_NODE
#error "core_expr_nodes.def: #define HANDLE_CORE_EXPR_NODE(Name, Wire) before #include-ing this node list"
#endif

HANDLE_CORE_EXPR_NODE(CoreLiteralExpr, "literal")
HANDLE_CORE_EXPR_NODE(CoreValueRefExpr, "value_ref")
HANDLE_CORE_EXPR_NODE(CorePathExpr, "path")
HANDLE_CORE_EXPR_NODE(CoreQualifiedExpr, "qualified")
HANDLE_CORE_EXPR_NODE(CoreUnaryExpr, "unary")
HANDLE_CORE_EXPR_NODE(CoreBinaryExpr, "binary")
HANDLE_CORE_EXPR_NODE(CoreConstructExpr, "construct")
HANDLE_CORE_EXPR_NODE(CoreCoerceExpr, "coerce")
HANDLE_CORE_EXPR_NODE(CoreCollectionExpr, "collection")
HANDLE_CORE_EXPR_NODE(CoreUnsupportedExpr, "unsupported")
HANDLE_CORE_EXPR_NODE(CoreCallExpr, "call")
// RFC 0026 FB-3a1 (CORE-FNBODY-DESIGN §3.1/§5.2): closure construction and the
// indirect closure-value call. The data model lands first; lambda lifting (which
// makes the lowerer emit these) arrives in FB-3a2, so until then the nodes are
// unreachable from lowering but carry full structural verification + wire
// symmetry like every other node.
HANDLE_CORE_EXPR_NODE(CoreClosureExpr, "closure")
HANDLE_CORE_EXPR_NODE(CoreCallClosureExpr, "call_closure")

#undef HANDLE_CORE_EXPR_NODE
