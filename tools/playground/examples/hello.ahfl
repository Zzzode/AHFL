// Hello World - Basic AHFL Agent and Workflow

module playground;

pub struct GreetRequest {
    name: String;
}

pub struct GreetResponse {
    message: String;
}

pub agent Greeter {
    input: GreetRequest;
    context: Unit;
    output: GreetResponse;
    states: [Idle, Greeting, Done];
    initial: Idle;
    final: [Done];
    capabilities: [];
    transition Idle -> Greeting;
    transition Greeting -> Done;
}

flow for Greeter {
    state Idle {
        goto Greeting;
    }

    state Greeting {
        goto Done;
    }

    state Done {
        return GreetResponse { message: "Hello, " + input.name };
    }
}

pub workflow HelloWorkflow {
    input: GreetRequest;
    output: GreetResponse;

    node greet: Greeter(input);

    return: greet;
}
