{
  "Agent": {
    "prefix": "agent",
    "body": [
      "agent ${1:AgentName} {",
      "    input: ${2:InputType};",
      "    context: ${3:ContextType};",
      "    output: ${4:OutputType};",
      "    states: [${5:Init, Done}];",
      "    initial: ${6:Init};",
      "    final: [${7:Done}];",
      "    capabilities: [${8:}];",
      "    transition ${9:Init} -> ${10:Done};",
      "}"
    ],
    "description": "Define a new AHFL agent"
  },
  "Workflow": {
    "prefix": "workflow",
    "body": [
      "workflow ${1:WorkflowName} {",
      "    input: ${2:InputType};",
      "    output: ${3:OutputType};",
      "    node ${4:step}: ${5:AgentName}(input);",
      "    return: ${6:step};",
      "}"
    ],
    "description": "Define a new AHFL workflow"
  },
  "Capability": {
    "prefix": "capability",
    "body": [
      "capability ${1:CapName}(request: ${2:RequestType}) -> ${3:ResponseType};"
    ],
    "description": "Define a new AHFL capability"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:StructName} {",
      "    ${2:field}: ${3:Type};",
      "}"
    ],
    "description": "Define a new AHFL struct"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:EnumName} {",
      "    ${2:Variant1},",
      "    ${3:Variant2}(${4:Type}),",
      "}"
    ],
    "description": "Define a new AHFL enum"
  },
  "Type Alias": {
    "prefix": "type",
    "body": [
      "type ${1:AliasName} = ${2:Type};"
    ],
    "description": "Define a type alias"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:param}: ${3:Type}) -> ${4:ReturnType} effect Pure decreases 0 {",
      "    ${5:// body}",
      "}"
    ],
    "description": "Define a new AHFL function"
  },
  "Trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:TraitName} {",
      "    ${2:fn method(self) -> ${3:ReturnType} effect Pure;}",
      "}"
    ],
    "description": "Define a new AHFL trait"
  },
  "Impl (Trait)": {
    "prefix": "impl",
    "body": [
      "impl ${1:Trait} for ${2:Type} {",
      "    ${3:fn method(self) -> ${4:ReturnType} effect Pure decreases 0 {",
      "        ${5:// body}",
      "    }}",
      "}"
    ],
    "description": "Implement a trait for a type"
  },
  "Impl (Inherent)": {
    "prefix": "impl",
    "body": [
      "impl ${1:Type} {",
      "    ${2:fn method(self) -> ${3:ReturnType} effect Pure decreases 0 {",
      "        ${4:// body}",
      "    }}",
      "}"
    ],
    "description": "Define an inherent impl block for a type"
  },
  "Contract": {
    "prefix": "contract",
    "body": [
      "contract for ${1:AgentName} {",
      "    requires: ${2:precondition};",
      "    ensures: ${3:postcondition};",
      "    invariant: ${4:always condition};",
      "}"
    ],
    "description": "Define a contract for an agent"
  },
  "Flow": {
    "prefix": "flow",
    "body": [
      "flow for ${1:AgentName} {",
      "    state ${2:Init} {",
      "        ${3:// logic}",
      "        goto ${4:Done};",
      "    }",
      "",
      "    state ${5:Done} {",
      "        return ${6:output};",
      "    }",
      "}"
    ],
    "description": "Define a flow implementation for an agent"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "    ${2:Pattern} => ${3:result},",
      "    ${4:_} => ${5:default},",
      "}"
    ],
    "description": "Match expression"
  },
  "Transition": {
    "prefix": "transition",
    "body": [
      "transition ${1:FromState} -> ${2:ToState};"
    ],
    "description": "Define a state transition"
  }
}
