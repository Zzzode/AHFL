{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AHFL",
  "scopeName": "source.ahfl",
  "patterns": [
    { "include": "#doc-comments" },
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "doc-comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.ahfl",
          "match": "///.*$"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ahfl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ahfl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.builtin.ahfl",
          "begin": "(@)(builtin)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.annotation.ahfl" },
            "2": { "name": "entity.name.function.attribute.ahfl" },
            "3": { "name": "punctuation.section.group.begin.ahfl" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.section.group.end.ahfl" }
          },
          "patterns": [
            { "include": "#strings" }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.declaration.module.ahfl",
          "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.declaration.module.ahfl" },
            "2": { "name": "entity.name.namespace.ahfl" }
          }
        },
        {
          "name": "meta.declaration.import.ahfl",
          "match": "\\b(import|use)\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.control.import.ahfl" },
            "2": { "name": "entity.name.namespace.ahfl" },
            "3": { "name": "keyword.control.import.alias.ahfl" },
            "4": { "name": "entity.name.namespace.alias.ahfl" }
          }
        },
        {
          "name": "meta.declaration.nominal.ahfl",
          "match": "\\b(pub\\s+)?(struct|enum|trait|agent|workflow|capability)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.visibility.ahfl" },
            "2": { "name": "keyword.declaration.type.ahfl" },
            "3": { "name": "entity.name.type.ahfl" }
          }
        },
        {
          "name": "meta.declaration.function.ahfl",
          "match": "\\b(pub\\s+)?(fn|predicate)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.visibility.ahfl" },
            "2": { "name": "keyword.declaration.function.ahfl" },
            "3": { "name": "entity.name.function.ahfl" }
          }
        },
        {
          "name": "meta.declaration.type-alias.ahfl",
          "match": "\\b(pub\\s+)?(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.visibility.ahfl" },
            "2": { "name": "keyword.declaration.type.ahfl" },
            "3": { "name": "entity.name.type.alias.ahfl" }
          }
        },
        {
          "name": "meta.declaration.const.ahfl",
          "match": "\\b(pub\\s+)?(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.visibility.ahfl" },
            "2": { "name": "keyword.declaration.const.ahfl" },
            "3": { "name": "variable.other.constant.ahfl" }
          }
        },
        {
          "name": "meta.declaration.contract-or-flow.ahfl",
          "match": "\\b(contract|flow)\\s+(for)\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.declaration.ahfl-domain.ahfl" },
            "2": { "name": "keyword.control.ahfl" },
            "3": { "name": "entity.name.type.ahfl" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.modifier.visibility.ahfl",
          "match": "\\bpub\\b"
        },
        {
          "name": "storage.modifier.mutability.ahfl",
          "match": "\\bmut\\b"
        },
        {
          "name": "variable.language.self.ahfl",
          "match": "\\bself\\b"
        },
        {
          "name": "keyword.control.flow.ahfl",
          "match": "\\b(if|else|match|return|let|goto|assert|unwrap|requires|unreachable)\\b"
        },
        {
          "name": "keyword.control.import.ahfl",
          "match": "\\b(import|use|as)\\b"
        },
        {
          "name": "keyword.declaration.ahfl",
          "match": "\\b(module|struct|enum|type|const|fn|predicate|trait|impl|capability|agent|workflow|contract|flow)\\b"
        },
        {
          "name": "keyword.other.generic.ahfl",
          "match": "\\b(where|effect|decreases)\\b"
        },
        {
          "name": "storage.modifier.effect.ahfl",
          "match": "\\b(Pure|Nondet)\\b"
        },
        {
          "name": "keyword.operator.word.logical.ahfl",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.other.agent.ahfl",
          "match": "\\b(input|output|context|states|initial|final|capabilities|quota|max_tool_calls|max_execution_time|transition)\\b"
        },
        {
          "name": "keyword.other.workflow.ahfl",
          "match": "\\b(node|after|safety|liveness)\\b"
        },
        {
          "name": "keyword.other.flow.ahfl",
          "match": "\\b(state|with|retry|retry_on|timeout)\\b"
        },
        {
          "name": "keyword.other.contract.ahfl",
          "match": "\\b(ensures|invariant|forbid|always|eventually|next|until|called|in_state|running|completed)\\b"
        },
        {
          "name": "keyword.other.capability-effect.ahfl",
          "match": "\\b(domain|idempotency|receipt|compensation|policy|read|external_side_effect|durable_write|financial_write|unknown|required|optional|safe|safe_if_idempotent|unsafe)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ahfl",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.none.ahfl",
          "match": "\\bnone\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.ahfl",
          "match": "\\b(Unit|Bool|Int|Float|String|UUID|Timestamp|Duration|Decimal)\\b"
        },
        {
          "name": "support.type.collection.ahfl",
          "match": "\\b(Optional|List|Set|Map|Fn)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.ahfl",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.comparison.ahfl",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.ahfl",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.ahfl",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.ahfl",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.access.ahfl",
          "match": "(::|\\.|\\?)"
        },
        {
          "name": "keyword.operator.pattern.ahfl",
          "match": "(@|\\|)"
        },
        {
          "name": "keyword.operator.lambda.ahfl",
          "match": "\\\\"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ahfl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ahfl",
              "match": "\\\\[\"\\\\nrt]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.ahfl",
          "match": "\\b[0-9]+(?:ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.decimal.ahfl",
          "match": "\\b[0-9]+\\.[0-9]+d\\b"
        },
        {
          "name": "constant.numeric.float.ahfl",
          "match": "\\b[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.ahfl",
          "match": "\\b[0-9]+\\b"
        }
      ]
    }
  }
}
