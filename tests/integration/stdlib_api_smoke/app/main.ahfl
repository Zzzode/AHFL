module app::main;

import std::collections as collections;
import std::option as option;
import std::result as results;
import std::string as strings;
import std::time as time;
import std::uuid as uuid;

fn smoke(
    maybe: option::Option<Int>,
    outcome: results::Result<Int, String>,
    xs: collections::List<Int>,
    numbers: collections::Set<Int>,
    lookup: collections::Map<String, Int>,
    text: String,
    stamp: Timestamp,
    delta: Duration,
    id: UUID
) -> Int {
    let none_int: option::Option<Int> = option::option_none<Int>();
    let mapped = maybe.map<Int>(\x: Int -> x + 1);
    let chained = mapped.and_then<Int>(\x: Int -> option::some<Int>(x + 2));
    let recovered = none_int.or_else(\ -> option::some<Int>(7));
    let filtered_option = chained.filter(\x: Int -> x > 0);
    let lazy_default = none_int.unwrap_or_else(\ -> 5);
    let inserted = none_int.get_or_insert(6);
    let has_value = mapped.is_some();
    let is_empty = none_int.is_none();
    let a = mapped.unwrap_or(0);
    let option_total = filtered_option.unwrap_or(0)
        + recovered.unwrap_or(0)
        + lazy_default
        + inserted;

    let result_mapped = outcome.map<Int>(\x: Int -> x + 2);
    let result_error_mapped = outcome.map_err<String>(\e: String -> e);
    let result_chained = outcome.and_then<Int>(\x: Int -> result_mapped);
    let result_recovered = result_error_mapped.or_else<String>(\e: String -> result_mapped);
    let result_ok = result_chained.is_ok();
    let result_err = result_recovered.is_err();
    let ok_option = result_chained.ok();
    let err_option = result_recovered.err();
    let b = result_recovered.unwrap_or(0);

    let empty_list = collections::empty<Int>();
    let singleton = collections::singleton<Int>(a);
    let empty_check = empty_list.is_empty();
    let item = xs.get(0);
    let first_item = xs.first();
    let last_item = xs.last();
    let kept = xs.filter(\x: Int -> true);
    let appended = singleton.append(kept);
    let total = kept.fold<Int>(0, \(acc: Int, x: Int) -> acc + x);
    let appended_total = appended.fold<Int>(0, \(acc: Int, x: Int) -> acc + x);
    let empty_set = collections::set_empty<Int>();
    let singleton_set = collections::set_singleton<Int>(a);
    let set_empty_check = empty_set.is_empty();
    let has_number = numbers.contains(a);
    let singleton_has_number = singleton_set.contains(a);
    let empty_map = collections::map_empty<String, Int>();
    let singleton_map = collections::map_singleton<String, Int>(text, a);
    let map_empty_check = empty_map.is_empty();
    let has_key = lookup.contains_key(text);
    let singleton_has_key = singleton_map.contains_key(text);
    let found = lookup.get(text);
    let parsed_id = uuid::parse(uuid::to_string(id));
    let shifted = time::sub(time::add(stamp, delta), delta);

    return a + b + total + appended_total + option_total
        + ok_option.unwrap_or(0)
        + text.length()
        + (uuid::to_string(id)).length();
}

fn runtime_bump(x: Int) -> Int effect Pure decreases 0 {
    return (("ab").concat("cd")).length() + x;
}

fn runtime_collections_score() -> Int effect Pure decreases 0 {
    let xs: collections::List<Int> = collections::list_from_array<Int>(1, 2, 3);
    let mapped = xs.map<Int>(\x: Int -> runtime_bump(x));
    let filtered = mapped.filter(\x: Int -> x > 5);
    let total = filtered.fold<Int>(0, \(acc: Int, x: Int) -> acc + x);
    let first = filtered.first();
    let last = filtered.last();
    return total
        + first.unwrap_or(0)
        + last.unwrap_or(0);
}

fn runtime_option_result_score() -> Int effect Pure decreases 0 {
    let maybe: option::Option<Int> = option::some<Int>(3);
    let mapped = maybe.map<Int>(\x: Int -> runtime_bump(x));
    let filtered = mapped.filter(\x: Int -> x > 5);
    let option_score = filtered.unwrap_or_else(\ -> 0);

    let outcome: results::Result<Int, String> = results::Result::Ok(4);
    let result_mapped = outcome.map<Int>(\x: Int -> runtime_bump(x));
    let result_score = result_mapped.unwrap_or(0);
    return option_score + result_score;
}
