module stdlib_units::option_ut;

import std::option as option;

// Option<T> unit-test template (corelib-support-workplan M0-3 / blocker B3).
// 25 assertions: 15 positive (Some operations) + 10 boundary (None / edge).
// Each `assert` carries a meaningful Bool over the Option API surface, so the
// file both type-checks the public API (`ahflc check`) and encodes intended
// runtime semantics for a future execution harness. Modeled on
// tests/integration/stdlib_api_smoke (free-function surface).
//
// RFC 0013 P2-S1 (Step 10): the explicit type-argument workaround is retired.
// Calls whose receiver is `Some(concrete)` or whose lambda body drives
// inference now use the un-annotated top-level form (R3 left-fold + R5
// flow-back). Explicit type args are retained only where the type parameter
// genuinely cannot be inferred (None-only receivers, arithmetic on unbound
// lambda params).
fn option_ut() -> Int effect Pure decreases 0 {
    // ===== 15 positive: Option::Some(...) operations =====
    assert(option::is_some(option::Option::Some(1)));
    assert(option::is_none<Int>(option::Option::None));
    assert(option::is_some(option::map(option::Option::Some(1), \x -> x + 1)));
    assert(option::unwrap_or(option::map(option::Option::Some(5), \x -> x * 2), 0) == 10);
    assert(option::is_some(option::and_then(option::Option::Some(1), \x -> option::Option::Some(x + 1))));
    assert(option::unwrap_or(option::and_then(option::Option::Some(2), \x -> option::Option::Some(x * 3)), 0) == 6);
    assert(option::unwrap_or(option::filter(option::Option::Some(4), \x -> x > 0), 0) == 4);
    assert(option::unwrap_or(option::or_else(option::Option::Some(8), \ -> option::Option::Some(0)), 0) == 8);
    assert(option::unwrap_or(option::Option::Some(9), 0) == 9);
    assert(option::unwrap_or_else(option::Option::Some(3), \ -> 0) == 3);
    assert(option::get_or_insert(option::Option::Some(7), 0) == 7);
    assert(option::unwrap_or(option::map(option::Option::Some(10), \x -> x - 1), 0) == 9);
    assert(option::is_some(option::or_else(option::Option::Some(1), \ -> option::Option::Some(2))));
    assert(option::unwrap_or(option::or_else(option::Option::Some(5), \ -> option::Option::Some(2)), 0) == 5);
    assert(option::unwrap_or(option::map(option::Option::Some(6), \x -> x + x), 0) == 12);

    // ===== 10 boundary: Option::None and edge behaviors =====
    // Explicit type args retained: None-only receivers cannot infer T, and
    // lambdas over unbound T cannot typecheck arithmetic / comparison.
    assert(option::is_none<Int>(option::map<Int, Int>(option::Option::None, \x: Int -> x + 1)));
    assert(option::is_none<Int>(option::and_then<Int, Int>(option::Option::None, \x: Int -> option::Option::Some(x))));
    assert(option::is_none<Int>(option::and_then<Int, Int>(option::Option::Some(1), \x: Int -> option::Option::None)));
    assert(option::is_none(option::filter(option::Option::Some(4), \x -> x > 10)));
    assert(option::is_none<Int>(option::filter<Int>(option::Option::None, \x: Int -> x > 0)));
    assert(option::unwrap_or(option::Option::None, 42) == 42);
    assert(option::unwrap_or_else(option::Option::None, \ -> 42) == 42);
    assert(option::get_or_insert(option::Option::None, 8) == 8);
    assert(option::unwrap_or<Int>(option::and_then<Int, Int>(option::Option::None, \x: Int -> option::Option::Some(x)), 7) == 7);
    assert(option::unwrap_or(option::or_else(option::Option::None, \ -> option::Option::Some(11)), 0) == 11);

    // ===== 4 xor (M1-2): Some iff exactly one of self/other is Some =====
    assert(option::is_some(option::xor(option::Option::Some(1), option::Option::None)));
    assert(option::is_some(option::xor(option::Option::None, option::Option::Some(2))));
    assert(option::is_none(option::xor(option::Option::Some(1), option::Option::Some(2))));
    assert(option::is_none<Int>(option::xor<Int>(option::Option::None, option::Option::None)));

    // ===== 2 flat_map (M1-1): alias of and_then =====
    assert(option::is_some(option::flat_map(option::Option::Some(2), \x -> option::Option::Some(x * 3))));
    assert(option::is_none<Int>(option::flat_map<Int, Int>(option::Option::None, \x: Int -> option::Option::Some(x))));

    return 0;
}
