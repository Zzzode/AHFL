module stdlib_units::list_ut;

import std::collections as collections;
import std::option as option;
import std::traits as traits;

// List<T> unit-test matrix (M1-7 / B3). UFCS surface.
fn list_ut() -> Int effect Pure decreases 0 {
    let xs: collections::List<Int> = collections::list_cons<Int>(1, collections::list_cons<Int>(2, collections::singleton<Int>(3)));
    let ys: collections::List<Int> = collections::empty<Int>();

    // construction / size
    assert(xs.length() == 3);
    assert(ys.length() == 0);
    assert(ys.is_empty());
    assert((collections::singleton<Int>(7)).length() == 1);
    assert((collections::list_cons<Int>(0, xs)).length() == 4);

    // access
    assert((xs.get(0)).unwrap_or(0) == 1);
    assert((xs.get(2)).unwrap_or(0) == 3);
    assert((xs.get(9)).is_none());
    assert((xs.first()).unwrap_or(0) == 1);
    assert((xs.last()).unwrap_or(0) == 3);
    assert((ys.first()).is_none());

    // fold / map / filter
    assert(xs.fold<Int>(0, \(acc: Int, x: Int) -> acc + x) == 6);
    assert(ys.fold<Int>(0, \(acc: Int, x: Int) -> acc + x) == 0);
    assert((xs.map<Int>(\x: Int -> x * 2)).length() == 3);
    assert(((xs.map<Int>(\x: Int -> x * 2)).first()).unwrap_or(0) == 2);
    assert((xs.filter(\x: Int -> x > 1)).length() == 2);
    assert((xs.filter(\x: Int -> x > 9)).length() == 0);

    // append
    assert((xs.append(xs)).length() == 6);
    assert(((xs.append(xs)).last()).unwrap_or(0) == 3);

    // sort / dedup / slice (M2-1)
    let unsorted: collections::List<Int> = collections::list_cons<Int>(3, collections::list_cons<Int>(1, collections::list_cons<Int>(2, collections::singleton<Int>(1))));
    let sorted: collections::List<Int> = collections::sort<Int>(unsorted);
    assert(sorted.length() == 4);
    assert((sorted.first()).unwrap_or(0) == 1);
    assert((sorted.last()).unwrap_or(0) == 3);
    assert((collections::dedup<Int>(sorted)).length() == 3);

    // ---- §6.2 container-trait dispatch (RFC 0013 P5 / KR5.5) ---------------
    // These call the Foldable / Iterable / Functor trait methods on List<Int>.
    // iter_head / iter_tail / iter_next / to_list / for_each have NO inherent
    // namesake, so resolving them is a genuine test of trait-impl dispatch.
    assert((xs.iter_head()).unwrap_or(0) == 1);
    assert((xs.iter_next()).unwrap_or(0) == 1);
    assert(xs.iter_tail().length() == 2);
    assert((ys.iter_head()).is_none());
    assert(ys.iter_tail().length() == 0);

    // to_list returns Self (element-typed Foldable), length preserved.
    // Bind through the traits::List<T> alias so the std::traits import is
    // counted as used (the trait impls it brings into scope are consumed by
    // method dispatch, which the unused-import lint does not track).
    let same: traits::List<Int> = xs.to_list();
    assert(same.length() == 3);

    // Foldable::fold has an element-typed accumulator (T == Int here); this
    // dispatches through the trait, distinct from the inherent fold<U>.
    assert(xs.fold(0, \ (acc: Int, x: Int) -> acc + x) == 6);

    // for_each returns Unit; called for the (Pure) traversal.
    xs.for_each(\ (x: Int) -> {});

    // Functor::map is Fn(T) -> T -> Self (T == Int), unlike inherent map<U>.
    assert(xs.map(\ (x: Int) -> x + 1).length() == 3);
    assert((xs.map(\ (x: Int) -> x + 1).first()).unwrap_or(0) == 2);

    return 0;
}
