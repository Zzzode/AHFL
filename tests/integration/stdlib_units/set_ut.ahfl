module stdlib_units::set_ut;

import std::collections as collections;

// Set<T> unit-test matrix (M1-7 / B3). UFCS surface. Set's public API is thin
// (empty/singleton/is_empty/contains); set-theoretic ops are M2. Negatives use
// `not` / `== true` (both verified to typecheck).
fn set_ut() -> Int effect Pure decreases 0 {
    let s: collections::Set<Int> = collections::set_singleton<Int>(1);
    let e: collections::Set<Int> = collections::set_empty<Int>();

    // empty / non-empty
    assert(e.is_empty());
    assert(not s.is_empty());
    assert((collections::set_empty<Int>()).is_empty() == true);
    assert((collections::set_singleton<Int>(0)).is_empty() == false);

    // contains (positive)
    assert(s.contains(1));
    assert((collections::set_singleton<Int>(5)).contains(5));
    assert((collections::set_singleton<Int>(0)).contains(0));

    // contains (negative)
    assert(not s.contains(99));
    assert(not (collections::set_singleton<Int>(5)).contains(6));
    assert(not (collections::set_singleton<Int>(0)).contains(1));
    assert(not e.contains(1));
    assert(not e.contains(0));

    // distinct singletons are distinct
    assert((collections::set_singleton<Int>(42)).contains(42));
    assert(not (collections::set_singleton<Int>(42)).contains(7));

    // set algebra (M2-2): union / intersection / difference / is_subset
    let s12: collections::Set<Int> = collections::set_union<Int>(collections::set_singleton<Int>(1), collections::set_singleton<Int>(2));
    let s23: collections::Set<Int> = collections::set_union<Int>(collections::set_singleton<Int>(2), collections::set_singleton<Int>(3));
    // union
    assert(s12.contains(1));
    assert(s12.contains(2));
    assert(not s12.contains(3));
    // intersection {1,2} ∩ {2,3} = {2}
    assert((collections::set_intersection<Int>(s12, s23)).contains(2));
    assert(not (collections::set_intersection<Int>(s12, s23)).contains(1));
    assert(not (collections::set_intersection<Int>(s12, s23)).contains(3));
    // difference {1,2} - {2,3} = {1}
    assert((collections::set_difference<Int>(s12, s23)).contains(1));
    assert(not (collections::set_difference<Int>(s12, s23)).contains(2));
    // is_subset
    assert(collections::set_is_subset<Int>(s, s12));
    assert(not collections::set_is_subset<Int>(s12, s));
    assert(collections::set_is_subset<Int>(s12, s12));

    return 0;
}
