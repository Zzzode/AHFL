module stdlib_units::map_ut;

import std::collections as collections;
import std::option as option;
import std::traits as traits;

// Map<K, V> unit-test matrix (M1-7 / B3). UFCS surface.
fn map_ut() -> Int effect Pure decreases 0 {
    let m: collections::Map<String, Int> = collections::map_singleton<String, Int>("a", 1);
    let e: collections::Map<String, Int> = collections::map_empty<String, Int>();
    let m2: collections::Map<String, Int> = collections::map_from_entries<String, Int>("a", 1, "b", 2, "c", 3, "d", 4);

    // empty / singleton
    assert(e.is_empty());
    assert(m.contains_key("a"));
    assert((m.get("a")).unwrap_or(0) == 1);
    assert((m.get("z")).is_none());
    assert((e.get("a")).is_none());

    // multi-entry (map_from_entries: 4 pairs)
    assert(m2.contains_key("a"));
    assert(m2.contains_key("d"));
    assert((m2.get("a")).unwrap_or(0) == 1);
    assert((m2.get("b")).unwrap_or(0) == 2);
    assert((m2.get("c")).unwrap_or(0) == 3);
    assert((m2.get("d")).unwrap_or(0) == 4);
    assert((m2.get("zzz")).is_none());

    // map_values / filter_keys (M2-3)
    let mv: collections::Map<String, Int> = m2;
    let doubled: collections::Map<String, Int> = collections::map_values<String, Int, Int>(mv, \v: Int -> v * 2);
    assert(doubled.contains_key("a"));
    assert((doubled.get("a")).unwrap_or(0) == 2);
    assert((doubled.get("c")).unwrap_or(0) == 6);
    let only_a: collections::Map<String, Int> = collections::filter_keys<String, Int>(mv, \k: String -> k == "a");
    assert(only_a.contains_key("a"));
    assert(not only_a.contains_key("b"));
    assert(not only_a.contains_key("c"));

    // ---- §6.2 Functor dispatch on Map (RFC 0013 P5 / KR5.5) ---------------
    // Functor<V>::map for Map maps every value (keys preserved), dispatched
    // through the std::traits impl rather than the map_values UFCS helper.
    let via_trait: traits::Map<String, Int> = m2.map(\ (v: Int) -> v + 10);
    assert(via_trait.contains_key("a"));
    assert((via_trait.get("a")).unwrap_or(0) == 11);
    assert((via_trait.get("d")).unwrap_or(0) == 14);

    return 0;
}
