module refund_audit::directory_export;

import audit_core::api as api;

pub struct DirectoryExportInput {
    subject: api::AuditApiRequest;
}

pub struct DirectoryExportOutput {
    accepted: Bool;
}

pub workflow DirectoryExportWorkflow {
    input: DirectoryExportInput;
    output: DirectoryExportOutput;
    return: DirectoryExportOutput {
        accepted: true,
    };
}
