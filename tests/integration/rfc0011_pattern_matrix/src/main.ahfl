module rfc0011_pattern_matrix::main;

enum Level {
    Low,
    High,
}

enum Packet {
    Empty,
    Data { level: Level, count: Int(0, 2), empty: String(0, 0) },
}

fn classify(packet: Packet) -> Int effect Pure decreases 0 {
    return match packet {
        Empty => 0,
        Data { level: Low, count: 0..1, empty: "" } => 1,
        Data { level: Low, count: 2, empty: "" } => 2,
        Data { level: High, count: 0, empty: "" } => 3,
        Data { level: High, count: 1..2, empty: "" } => 4,
    };
}
