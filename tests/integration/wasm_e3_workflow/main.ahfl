module wasm_e3::main;

pub struct Frame {
    value: String;
}

pub agent FirstAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, Start];
    initial: Start;
    final: [Done];
    capabilities: [];
    transition Start -> Done;
}

flow for FirstAgent {
    state Done {
        return input;
    }

    state Start {
        goto Done;
    }
}

pub agent SecondAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, Start];
    initial: Start;
    final: [Done];
    capabilities: [];
    transition Start -> Done;
}

flow for SecondAgent {
    state Done {
        return input;
    }

    state Start {
        goto Done;
    }
}

pub workflow IdentityPipeline {
    input: Frame;
    output: Frame;

    node first: FirstAgent(input);
    node second: SecondAgent(first) after [first];

    return: second;
}
