struct Request {
    value: String;
}

struct Context {
    value: String = "pending";
}

struct Response {
    value: String;
}

capability Validate(request: Request) -> Bool;

agent EchoAgent {
    input: Request;
    context: Context;
    output: Response;
    states: [Init, Done];
    initial: Init;
    final: [Done];
    capabilities: [Validate];
    transition Init -> Done;
}

flow for EchoAgent {
    state Init {
        goto Done;
    }

    state Done {
        return Response {
            value: input.value,
        };
    }
}

workflow CalledInWorkflow {
    input: Request;
    output: Response;

    node run: EchoAgent(input);

    safety: always called(Validate);

    return: run;
}
