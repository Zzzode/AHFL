struct Request {
    value: String;
}

struct Context {
    value: String = "pending";
}

struct Response {
    value: String;
}

agent InitialStateNotDeclaredAgent {
    input: Request;
    context: Context;
    output: Response;
    states: [Init, Done];
    initial: Ghost;
    final: [Done];
    capabilities: [];
    transition Init -> Done;
}
