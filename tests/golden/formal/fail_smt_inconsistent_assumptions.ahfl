module formal::inconsistent_data_assumptions;

// Contradictory requires must fail the explicit data-contract proof request.
// A false precondition cannot establish an arbitrary postcondition by vacuity.

struct Request {
    x: Int;
}

struct Context {
    value: Int = 0;
}

struct Response {
    ok: Bool;
}

agent RefutedAgent {
    input: Request;
    context: Context;
    output: Response;
    states: [Init, Done];
    initial: Init;
    final: [Done];
    capabilities: [];
    transition Init -> Done;
}

contract for RefutedAgent {
    requires: input.x > 0;
    requires: input.x <= 0;
    ensures: input.x >= 1;
}

flow for RefutedAgent {
    state Init {
        goto Done;
    }

    state Done {
        return Response {
            ok: true,
        };
    }
}
