// WH-5b.1 hybrid fixture: P6-packaged node BEFORE opaque capability-final node
// in the same workflow module. Both agents take the workflow entry input (no
// cross-lane data dependency); the workflow return is the P6 node's P4-D
// output. The Kahn schedule is [compute, echo] (declaration order).
//
// The module emits P6Frame (2 nodes, 1 import). The P6 node writes a tag-0
// identity event record; the cap node writes a tag-1 capability record.

module wasm::wh5b_hybrid_p6_before_cap;

pub struct Frame {
    n: Int;
}

pub struct Ctx {
    tag: Int = 0;
}

capability Echo(request: Frame) -> Frame;

// P6-packaged agent: computed-goto + computed-final.
pub agent ComputeAgent {
    input: Frame;
    context: Ctx;
    output: Frame;
    states: [Done, High, Low, Decide];
    initial: Decide;
    final: [Done];
    capabilities: [];
    transition Decide -> High;
    transition Decide -> Low;
    transition High -> Done;
    transition Low -> Done;
}

flow for ComputeAgent {
    state Decide {
        if (input.n > 0) {
            goto High;
        } else {
            goto Low;
        }
    }

    state High {
        goto Done;
    }

    state Low {
        goto Done;
    }

    state Done {
        return Frame { n: input.n };
    }
}

// Opaque capability-final agent.
pub agent EchoAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, Start];
    initial: Start;
    final: [Done];
    capabilities: [Echo];
    transition Start -> Done;
}

flow for EchoAgent {
    state Done {
        return Echo(input);
    }

    state Start {
        goto Done;
    }
}

pub workflow HybridPipeline {
    input: Frame;
    output: Frame;

    node compute: ComputeAgent(input);
    node echo: EchoAgent(input);

    return: compute;
}
