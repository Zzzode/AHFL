// RFC 0026 P6-7 frame-bridge v2 rung V2-B negative: the deduplicated String
// literal pool exceeds its fixed rodata region [256,1024). One 769-byte
// literal cannot fit the 768-byte reservation, so emission fails closed with
// wasm.RESOURCE_EXHAUSTED and no artifact (a compile-time D6 reject, never a
// runtime trap).
module wasm::v2b::rodata_overflow;

pub struct In {
    n: Int;
}

pub struct Out {
    label: String;
}

agent RodataOverflowAgent {
    input: In;
    context: Unit;
    output: Out;
    states: [Done, Start];
    initial: Start;
    final: [Done];
    capabilities: [];
    transition Start -> Done;
}

flow for RodataOverflowAgent {
    state Start {
        goto Done;
    }

    state Done {
        return Out {
            label: "",
        };
    }
}
