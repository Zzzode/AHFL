module wasm::p6_elseless_fallthrough;

// RFC 0026 P6-2 (KR6.6) else-less nested-if fall-through fixture. The inner if
// has NO else and only diverges on its then-branch (goto High); a false inner
// guard falls out of the inner if into the OUTER then-branch, which then runs
// off its own end into the handler's trailing goto Low. This is the exact
// core_region_exit contract (an absent branch is an implicit fallthrough) that a
// structured-if lowering must mirror: x=150 makes the outer guard true but the
// inner guard false, so the observed path is Decide -> Low.
pub struct Frame {
    value: String;
}

pub agent ElselessFallthroughAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, High, Low, Decide];
    initial: Decide;
    final: [Done];
    capabilities: [];
    transition Decide -> High;
    transition Decide -> Low;
    transition High -> Done;
    transition Low -> Done;
}

flow for ElselessFallthroughAgent {
    state Decide {
        let x = 150;
        if (x > 100) {
            if (x > 200) {
                goto High;
            }
        }
        goto Low;
    }

    state High {
        goto Done;
    }

    state Low {
        goto Done;
    }

    state Done {
        return input;
    }
}
