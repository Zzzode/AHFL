module wasm::p6_nested_fallthrough;

// RFC 0026 P6-1 (KR6.6) nested-control-flow fixture. The Decide handler nests
// a FULLY-DIVERGING if (both branches goto) inside an OUTER if whose taken
// branch continues to a fall-through goto. Before the context-sensitive
// blocktype fix the inner if was typed i32 purely because it always diverges,
// so its polymorphic branches left a stray i32 in the outer void branch and
// WebAssembly.compile rejected the module ('expected 0 elements on the stack
// for fallthru, found 1'). Here x=5 makes the outer guard false, exercising
// the fall-through path: Decide -> Low.
pub struct Frame {
    value: String;
}

pub agent NestedFallthroughAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, High, Mid, Low, Decide];
    initial: Decide;
    final: [Done];
    capabilities: [];
    transition Decide -> High;
    transition Decide -> Mid;
    transition Decide -> Low;
    transition High -> Done;
    transition Mid -> Done;
    transition Low -> Done;
}

flow for NestedFallthroughAgent {
    state Decide {
        let x = 5;
        if (x > 100) {
            if (x > 200) {
                goto High;
            } else {
                goto Mid;
            }
        }
        goto Low;
    }

    state High {
        goto Done;
    }

    state Mid {
        goto Done;
    }

    state Low {
        goto Done;
    }

    state Done {
        return input;
    }
}
