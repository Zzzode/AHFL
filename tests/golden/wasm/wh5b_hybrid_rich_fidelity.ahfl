// WH-5b.3 P2-2 rich-fidelity fixture: tag-only enum / String / Int / Bool
// across BOTH transcode directions on real wasm3.
//
// The workflow IO struct carries a tag-only enum, a String, an Int, and a
// Bool. The opaque echo node consumes the workflow entry through a
// P4D_TO_JSON ENTRY transcode (host reads the entry shadow, serializes every
// field to wire JSON) and its result crosses a JSON_TO_P4D workflow-output
// transcode (host decodes the wire JSON and packs every field back into
// P4-D, String bytes landing in the transcode payload arena). The P6 compute
// node exists to make this a hybrid (p6=true) workflow; it branches on
// input.n and returns the input unchanged.
//
// NOTE: payload-bearing enums and nested structs in the workflow return are
// rejected by the scheduler materializer
// (core_wasm_codegen.cpp:13069-13077, kUnsupportedWorkflowFrame); only flat
// fields (scalars, tag-only enums, String) are materializable. The
// wh5b_hybrid_rich_p6_to_opaque fixture exercises the distinct P4D_TO_JSON
// NODE_OUTPUT source path with the same flat fields. The JSON_TO_P4D
// direction with payload-bearing enums is blocked by the same materializer
// limitation (node input frames).
// std::option::Option / std::result::Result cannot be imported here because
// compile_conformance_source parses a single file without the sysroot module
// graph.
//
// Schedule: [compute(P6), echo(opaque)] (declaration order, no data dep).
//   - compute: source=ENTRY, lane=P6, entry encoding=P4-D. Same lane.
//   - echo: source=ENTRY, lane=opaque, entry encoding=P4-D.
//     Crossed -> P4D_TO_JSON transcode, source=ENTRY.
//   - return echo(opaque) -> workflow-output crossing.
//     JSON_TO_P4D transcode (echo output -> workflow_output region).

module wasm::wh5b_hybrid_rich_fidelity;

// Tag-only enum: discriminant only, no payload. Flat: the materializer
// handles it as an i32 discriminant.
pub enum Color {
    Red,
    Green,
    Blue,
}

pub struct Frame {
    n: Int;
    flag: Bool;
    color: Color;
    label: String;
}

pub struct Ctx {
    tag: Int = 0;
}

capability Echo(request: Frame) -> Frame;

// P6-packaged agent: computed-goto + computed-final.
pub agent ComputeAgent {
    input: Frame;
    context: Ctx;
    output: Frame;
    states: [Done, High, Low, Decide];
    initial: Decide;
    final: [Done];
    capabilities: [];
    transition Decide -> High;
    transition Decide -> Low;
    transition High -> Done;
    transition Low -> Done;
}

flow for ComputeAgent {
    state Decide {
        if (input.n > 0) {
            goto High;
        } else {
            goto Low;
        }
    }

    state High {
        goto Done;
    }

    state Low {
        goto Done;
    }

    state Done {
        return Frame { n: input.n, flag: input.flag, color: input.color, label: input.label };
    }
}

// Opaque capability-final agent.
pub agent EchoAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, Start];
    initial: Start;
    final: [Done];
    capabilities: [Echo];
    transition Start -> Done;
}

flow for EchoAgent {
    state Done {
        return Echo(input);
    }

    state Start {
        goto Done;
    }
}

pub workflow RichFidelity {
    input: Frame;
    output: Frame;

    node compute: ComputeAgent(input);
    node echo: EchoAgent(input) after [compute];

    return: echo;
}
