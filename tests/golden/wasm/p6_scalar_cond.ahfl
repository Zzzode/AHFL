module wasm::p6_scalar_cond;

// RFC 0026 P6-1 (KR6.6) real-frontend scalar computation fixture. The Decide
// handler performs ONLY scalar computation (no frame encoding): a literal
// add/mul chain compared against a constant drives a computed goto. The
// result is observable purely through the state ids step()/run transition
// through. The Done final keeps the canonical E1 identity return.
pub struct Frame {
    value: String;
}

pub agent ScalarCondAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, High, Low, Decide];
    initial: Decide;
    final: [Done];
    capabilities: [];
    transition Decide -> High;
    transition Decide -> Low;
    transition High -> Done;
    transition Low -> Done;
}

flow for ScalarCondAgent {
    state Decide {
        let a = 100 + 1;
        let b = a * 2;
        if (b > 150) {
            goto High;
        } else {
            goto Low;
        }
    }

    state High {
        goto Done;
    }

    state Low {
        goto Done;
    }

    state Done {
        return input;
    }
}
