module wasm::p2_13_branching_wirejson;

// P2-13: a WireJson agent whose walk terminal is a ComputedGotoAction.
// The linear walk cannot represent runtime-dependent branches, so the
// codegen must reject with wasm.UNSUPPORTED_ORCHESTRATION.

pub struct Frame {
    value: String;
    urgent: Bool;
}

pub agent BranchAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, High, Low, Decide];
    initial: Decide;
    final: [Done];
    capabilities: [];
    transition Decide -> High;
    transition Decide -> Low;
    transition High -> Done;
    transition Low -> Done;
}

flow for BranchAgent {
    state Decide {
        if (input.urgent) {
            goto High;
        } else {
            goto Low;
        }
    }

    state High {
        goto Done;
    }

    state Low {
        goto Done;
    }

    state Done {
        return input;
    }
}

pub workflow BranchWorkflow {
    input: Frame;
    output: Frame;

    node first: BranchAgent(input);

    return: first;
}
