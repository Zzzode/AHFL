module wasm::wh5c_instance_reuse_fanout;

// WH-5c.2 fixture: a workflow with TWO nodes (first, second) reusing ONE
// packaged agent instance (EchoAgent). The defect (GAP 1) was that the V2-D
// packager assigned one node-frame block per packaged INSTANCE and rejected
// instance reuse with a D5 lifecycle gate, so a fan-out workflow could not
// lower to wasm. Approach B (decision 12.15.16) flips the cardinality to one
// node-frame block + one runner function per P6 NODE, so both nodes lower
// onto their own block/runner and the workflow compiles and runs.

pub struct Frame {
    value: Int;
}

pub struct Ctx {
    echoed: Int = 0;
}

pub agent EchoAgent {
    input: Frame;
    context: Ctx;
    output: Frame;
    states: [Done, Init];
    initial: Init;
    final: [Done];
    transition Init -> Done;
}

flow for EchoAgent {
    state Init {
        ctx.echoed = input.value;
        goto Done;
    }

    state Done {
        return Frame { value: ctx.echoed };
    }
}

pub workflow ReuseFanout {
    input: Frame;
    output: Frame;

    node first: EchoAgent(input);
    node second: EchoAgent(first) after [first];

    return: second;
}
