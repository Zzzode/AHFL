module wasm::fb4_int64_capability_abi;

// RFC 0026 FB-4 / dual-track elimination: the capability import uses the
// bridge functype (i32)->(i32,i32) (control-block ptr in, status + result
// ptr out). An unbounded Int is Int64 in the P6 layout; the bridge protocol
// supports Int64 arguments and results via spill slots, so an Int -> Int
// capability called from an outlined fn is a valid P6-frame agent. The old
// opaque functype (i32,i32)->(i32,i32,i32) and its Int64 rejection were
// deleted with the WireJson lane.

capability Ping(x: Int) -> Int;

fn call_ping(n: Int) -> Int effect Ping {
    return Ping(n);
}

pub struct Frame {
    n: Int;
}

pub agent PingAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Init, Done];
    initial: Init;
    final: [Done];
    capabilities: [Ping];
    transition Init -> Done;
}

flow for PingAgent {
    state Init {
        let r: Int = call_ping(input.n);
        if (r == 42) {
            goto Done;
        } else {
            goto Done;
        }
    }
    state Done {
        return input;
    }
}
