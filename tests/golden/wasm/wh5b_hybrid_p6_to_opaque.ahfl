// WH-5b.3 AC1(b) fixture: P6->opaque NodeOutput cross-lane edge.
//
// The opaque echo node consumes the P6 compute node's O_k (NodeOutput
// source). The scheduler inserts a P4D_TO_JSON transcode that reads the
// P6 producer's INLINE O_k words, serializes to wire JSON, and passes the
// result to the opaque runner. The workflow return is the P6 node (no
// workflow-output crossing).
//
// Schedule: [compute(P6), echo(opaque)] (data dependency forces order).
//   - compute: source=ENTRY, lane=P6, entry encoding=P4-D. Same lane.
//   - echo: source=NODE_OUTPUT(compute), lane=opaque, source encoding=P4-D.
//     Crossed -> P4D_TO_JSON transcode, source=NODE_OUTPUT.
//   - return compute(P6) -> host reads O_k directly.

module wasm::wh5b_hybrid_p6_to_opaque;

pub struct Frame {
    n: Int;
}

pub struct Ctx {
    tag: Int = 0;
}

capability Echo(request: Frame) -> Frame;

// P6-packaged agent: computed-goto + computed-final.
pub agent ComputeAgent {
    input: Frame;
    context: Ctx;
    output: Frame;
    states: [Done, High, Low, Decide];
    initial: Decide;
    final: [Done];
    capabilities: [];
    transition Decide -> High;
    transition Decide -> Low;
    transition High -> Done;
    transition Low -> Done;
}

flow for ComputeAgent {
    state Decide {
        if (input.n > 0) {
            goto High;
        } else {
            goto Low;
        }
    }

    state High {
        goto Done;
    }

    state Low {
        goto Done;
    }

    state Done {
        return Frame { n: input.n };
    }
}

// Opaque capability-final agent.
pub agent EchoAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, Start];
    initial: Start;
    final: [Done];
    capabilities: [Echo];
    transition Start -> Done;
}

flow for EchoAgent {
    state Done {
        return Echo(input);
    }

    state Start {
        goto Done;
    }
}

pub workflow P6ToOpaque {
    input: Frame;
    output: Frame;

    node compute: ComputeAgent(input);
    node echo: EchoAgent(compute) after [compute];

    return: compute;
}
