module wasm::p6_cascade;

// RFC 0026 P6-2 (KR6.6) structured-control-flow fixture. The Decide handler is a
// 4-way CASCADE of nested if/else regions, each arm a goto: the compiled handler
// function must thread `br` past every enclosing if to reach its result-i32
// block. x=7 makes the outer guard (x>10) false, the second (x>5) true, so the
// observed path is Decide -> Mid -> Done while the other three arms stay dead.
// A wrong `br` depth (landing on an inner if instead of the handler block) makes
// WebAssembly.compile reject or misroutes the state id; the Node host asserts the
// exact native state sequence.
pub struct Frame {
    value: String;
}

pub agent CascadeAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, High, Mid, Low, None_, Decide];
    initial: Decide;
    final: [Done];
    capabilities: [];
    transition Decide -> High;
    transition Decide -> Mid;
    transition Decide -> Low;
    transition Decide -> None_;
    transition High -> Done;
    transition Mid -> Done;
    transition Low -> Done;
    transition None_ -> Done;
}

flow for CascadeAgent {
    state Decide {
        let x = 7;
        if (x > 10) {
            goto High;
        } else {
            if (x > 5) {
                goto Mid;
            } else {
                if (x > 0) {
                    goto Low;
                } else {
                    goto None_;
                }
            }
        }
    }

    state High {
        goto Done;
    }

    state Mid {
        goto Done;
    }

    state Low {
        goto Done;
    }

    state None_ {
        goto Done;
    }

    state Done {
        return input;
    }
}
