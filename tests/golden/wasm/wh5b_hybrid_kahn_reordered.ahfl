// WH-5b.1 hybrid fixture: 3-node Kahn-reordered workflow with interleaved
// opaque and P6-packaged nodes. The declaration order is [echo2, compute,
// echo1], but `after` dependencies force the Kahn schedule to
// [echo1, compute, echo2]. All nodes take the workflow entry input (no
// cross-lane data dependency); the workflow return is the P6 node's P4-D
// output.
//
// Two distinct opaque agent types (EchoAgent, EchoAgent2) are used so the
// IR assigns separate packaged instances (the shell-tuple dedup would
// otherwise collapse same-agent nodes into one instance and trip the D5
// no-reuse rule). The module emits P6Frame (3 nodes, 1 import). echo1 and
// echo2 write tag-1 capability records; compute writes a tag-0 identity
// record.

module wasm::wh5b_hybrid_kahn_reordered;

pub struct Frame {
    n: Int;
}

pub struct Ctx {
    tag: Int = 0;
}

capability Echo(request: Frame) -> Frame;

// Opaque capability-final agent (instance 1).
pub agent EchoAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, Start];
    initial: Start;
    final: [Done];
    capabilities: [Echo];
    transition Start -> Done;
}

flow for EchoAgent {
    state Done {
        return Echo(input);
    }

    state Start {
        goto Done;
    }
}

// Opaque capability-final agent (instance 2, distinct shell).
pub agent EchoAgent2 {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, Start];
    initial: Start;
    final: [Done];
    capabilities: [Echo];
    transition Start -> Done;
}

flow for EchoAgent2 {
    state Done {
        return Echo(input);
    }

    state Start {
        goto Done;
    }
}

// P6-packaged agent: computed-goto + computed-final.
pub agent ComputeAgent {
    input: Frame;
    context: Ctx;
    output: Frame;
    states: [Done, High, Low, Decide];
    initial: Decide;
    final: [Done];
    capabilities: [];
    transition Decide -> High;
    transition Decide -> Low;
    transition High -> Done;
    transition Low -> Done;
}

flow for ComputeAgent {
    state Decide {
        if (input.n > 0) {
            goto High;
        } else {
            goto Low;
        }
    }

    state High {
        goto Done;
    }

    state Low {
        goto Done;
    }

    state Done {
        return Frame { n: input.n };
    }
}

pub workflow HybridKahn {
    input: Frame;
    output: Frame;

    // Declared in NON-Kahn order: echo2 depends on compute, compute depends
    // on echo1. The Kahn schedule is [echo1, compute, echo2].
    node echo2: EchoAgent2(input) after [compute];
    node compute: ComputeAgent(input) after [echo1];
    node echo1: EchoAgent(input);

    return: compute;
}
