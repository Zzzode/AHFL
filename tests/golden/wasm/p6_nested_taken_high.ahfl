module wasm::p6_nested_taken_high;

// RFC 0026 P6-1 (KR6.6) nested-control-flow fixture. Unlike
// p6_nested_fallthrough, the outer guard is TRUE (x=300) and the inner
// fully-diverging if is actually ENTERED and takes its then-branch, proving a
// void-typed nested if still routes to High at runtime: Decide -> High.
pub struct Frame {
    value: String;
}

pub agent NestedTakenHighAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, High, Mid, Low, Decide];
    initial: Decide;
    final: [Done];
    capabilities: [];
    transition Decide -> High;
    transition Decide -> Mid;
    transition Decide -> Low;
    transition High -> Done;
    transition Mid -> Done;
    transition Low -> Done;
}

flow for NestedTakenHighAgent {
    state Decide {
        let x = 300;
        if (x > 100) {
            if (x > 200) {
                goto High;
            } else {
                goto Mid;
            }
        }
        goto Low;
    }

    state High {
        goto Done;
    }

    state Mid {
        goto Done;
    }

    state Low {
        goto Done;
    }

    state Done {
        return input;
    }
}
