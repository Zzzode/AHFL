// RFC 0026 P6 (KR6.6) f64 collection element ladder fixture. A bounded
// `List<Float>(4)` is a value whose whole runtime representation is the i32
// ADDRESS of its INLINE `(ptr,len)` header (P4-D `CoreLayoutContainer`), and
// the f64 elements live in an indirect backing store `stride` bytes apart.
// This fixture reads BOTH element 0 and element 1 through that header and
// branches on them, so a wrong element stride, a mis-sized f64 load (i32/i64
// instead of f64), or a wrong element offset all change the branch the agent
// takes and are observable purely through the state ids step() moves to.
//
// Layout (wasm32, P4-D): the Float element is f64 (8 bytes, align 8), so the
// container stride is 8 and the four-element backing store is 32 bytes. The
// header itself is `(ptr:i32, len:i32)` = 8 bytes INLINE in the input frame.
//
// The element values are supplied by the host (and the native run): element 0
// is ABOVE the threshold and element 1 is below it. The host poisons every
// slot outside the LIVE length (>= len) with a value above the threshold, so
// reading the WRONG element — a wrong stride, a wrong header offset, or a
// mis-sized load that lands anywhere other than slot 1 — routes to Low instead
// of High.
//
// The probe compiles ONE file with no sysroot, so the well-known collection
// nominal is declared here at its canonical std path. That is exactly the
// shape `builtin_nominal_table()` recognizes: the declaration role is stamped
// `List` from the descriptor SSOT, so the container layout and the capacity
// rules are the SAME as a sysroot-backed `std::collections::List`.
module std::collections;

pub struct List<T> { }

pub struct Frame {
    items: List<Float>(4);
}

pub agent F64CollectionAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, High, Low, Decide];
    initial: Decide;
    final: [Done];
    capabilities: [];
    transition Decide -> High;
    transition Decide -> Low;
    transition High -> Done;
    transition Low -> Done;
}

flow for F64CollectionAgent {
    state Decide {
        let xs: List<Float>(4) = input.items;
        let n: Int = xs.length;
        // Element 0 and element 1 at their P4-D stride, f64 loads. BOTH are
        // used by the branch: element 0 above the threshold, element 1 below.
        let first: Float = xs[0];
        let second: Float = xs[1];
        if (n == 2 && first > 50.0 && second < 50.0) {
            goto High;
        } else {
            goto Low;
        }
    }

    state High {
        goto Done;
    }

    state Low {
        goto Done;
    }

    state Done {
        return input;
    }
}
