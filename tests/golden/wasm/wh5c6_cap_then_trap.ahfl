module wasm::wh5c6_cap_then_trap;

// WH-5c.6 precedence fixture: a SUCCESSFUL capability call on the first
// node followed by a GENERIC trap (divide by zero, no capability context)
// on the second node. The failure diagnostic must carry the SECOND node's
// WorkflowNode::source_range, NOT the successful Echo capability's
// declaration range -- the section-13 resolution guards on
// last_error/last_capability_error so a source_symbol recorded for an
// earlier successful call is never blamed for an unrelated later trap.

pub struct Frame {
    n: Int;
    value: String;
}

pub struct Ctx {
    tag: Int = 0;
}

capability Echo(request: Frame) -> Frame;

// Opaque capability-final agent: calls Echo and returns its result.
pub agent EchoAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, Start];
    initial: Start;
    final: [Done];
    capabilities: [Echo];
    transition Start -> Done;
}

flow for EchoAgent {
    state Done {
        return Echo(input);
    }

    state Start {
        goto Done;
    }
}

// P6 agent that divides by zero in Done (a real wasm trap, no capability).
pub agent TrapAgent {
    input: Frame;
    context: Ctx;
    output: Frame;
    states: [Done, Decide];
    initial: Decide;
    final: [Done];
    capabilities: [];
    transition Decide -> Done;
}

flow for TrapAgent {
    state Decide {
        goto Done;
    }

    state Done {
        let x: Int = 1;
        let y: Int = 0;
        let z: Int = x / y;
        return Frame { n: z, value: input.value };
    }
}

pub workflow CapThenTrap {
    input: Frame;
    output: Frame;

    node first: EchoAgent(input);
    node second: TrapAgent(first) after [first];

    return: second;
}
