module wasm::p6_coerce_bounds;

// RFC 0026 P6-6 (KR6.6) same-repr coercion fixture: a BOUNDS RELAXATION with no
// physical effect. Both endpoints of the `IntWiden` proof op lie in the wasm32
// i32 scalar repr (P4-D `CoreLayoutScalar{I32}`), so the P4-D `value_layouts_equivalent`
// check proves the two value types are byte-identical and the emitted handler
// must contain NO widening instruction at all. The companion `p6_coerce.ahfl`
// covers the repr-GROWTH case (i32 -> i64, `i64.extend_i32_s`), so the pair pins
// BOTH sides of the layout-derived decision.
//
// The comparison below is observed purely through the state ids step() moves to.
pub struct Frame {
    value: String;
}

pub agent CoerceBoundsAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, High, Low, Decide];
    initial: Decide;
    final: [Done];
    capabilities: [];
    transition Decide -> High;
    transition Decide -> Low;
    transition High -> Done;
    transition Low -> Done;
}

flow for CoerceBoundsAgent {
    state Decide {
        let narrow: Int(0, 10) = 5;
        let wider: Int(0, 100) = narrow;
        let threshold: Int(0, 100) = 3;
        if (wider > threshold) {
            goto High;
        } else {
            goto Low;
        }
    }

    state High {
        goto Done;
    }

    state Low {
        goto Done;
    }

    state Done {
        return input;
    }
}
