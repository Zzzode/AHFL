// WH-5b.3 P2-2 rich-fidelity fixture: tag-only enum / String / Int / Bool
// across the P4D_TO_JSON NODE_OUTPUT transcode direction on real wasm3.
//
// The P6 compute node receives the rich workflow entry directly (P4-D, no
// transcode), constructs the output Frame forwarding every field, and its
// O_k is the workflow return (host reads O_k directly, no scheduler
// materializer). The opaque echo node consumes the P6 node's output through
// a P4D_TO_JSON NODE_OUTPUT transcode (host reads O_k, serializes every
// field to wire JSON). This exercises the NODE_OUTPUT source path (distinct
// from the ENTRY source path in wh5b_hybrid_rich_fidelity): the String
// PtrLen in O_k may point into the entry-payload arena or the rodata pool,
// and the transcode's String regions must admit it.
//
// NOTE: payload-bearing enums cannot be forwarded from the host-packed input
// to a constructed P6 output (core_wasm_codegen.cpp: "a computed final
// stores an aggregate/enum field sourced from the host-packed INPUT frame;
// input aggregates are packed inline and carry no module child address").
// The transcode packer/reader support them, but the P6 workflow lane cannot
// route them through a constructed output. Tag-only enums and String are
// flat and pass.

module wasm::wh5b_hybrid_rich_p6_to_opaque;

// Tag-only enum: discriminant only, no payload.
pub enum Color {
    Red,
    Green,
    Blue,
}

pub struct Frame {
    n: Int;
    flag: Bool;
    color: Color;
    label: String;
}

pub struct Ctx {
    tag: Int = 0;
}

capability Echo(request: Frame) -> Frame;

// P6-packaged agent: computed-goto + computed-final.
pub agent ComputeAgent {
    input: Frame;
    context: Ctx;
    output: Frame;
    states: [Done, High, Low, Decide];
    initial: Decide;
    final: [Done];
    capabilities: [];
    transition Decide -> High;
    transition Decide -> Low;
    transition High -> Done;
    transition Low -> Done;
}

flow for ComputeAgent {
    state Decide {
        if (input.n > 0) {
            goto High;
        } else {
            goto Low;
        }
    }

    state High {
        goto Done;
    }

    state Low {
        goto Done;
    }

    state Done {
        return Frame { n: input.n, flag: input.flag, color: input.color, label: input.label };
    }
}

// Opaque capability-final agent.
pub agent EchoAgent {
    input: Frame;
    context: Unit;
    output: Frame;
    states: [Done, Start];
    initial: Start;
    final: [Done];
    capabilities: [Echo];
    transition Start -> Done;
}

flow for EchoAgent {
    state Done {
        return Echo(input);
    }

    state Start {
        goto Done;
    }
}

pub workflow P6ToOpaqueRich {
    input: Frame;
    output: Frame;

    node compute: ComputeAgent(input);
    node echo: EchoAgent(compute) after [compute];

    return: compute;
}
